# Shared authentication token between Android app and local backend
GININI_TOKEN="change-this-to-a-secure-random-token"

# Absolute path to the ytmusicapi browser headers JSON file (MUST live outside the repository)
YTM_AUTH_FILE="C:\Users\Admin\.ginininini\browser.json"

# Target YouTube Music playlists
INBOX_PLAYLIST="Discovery Inbox"
ARTISTS_PLAYLIST="Artists to Explore"

# Optional: Claude API key for cleaning noisy Reddit/forum text
# ANTHROPIC_API_KEY=""
